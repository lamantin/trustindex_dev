<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Trustindex Mini{% endblock %}</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/7.2.0/mdb.min.css" rel="stylesheet"/>
</head>
<body class="bg-light" style="font-family: 'Roboto', sans-serif;">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-1-strong">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">
            <i class="fas fa-star-half-alt me-2"></i>Trustindex Mini
        </a>
        <div class="navbar-nav">
            <a class="nav-link" href="{{ path('app_home') }}"><i class="fas fa-home me-1"></i> Főoldal</a>
            <a class="nav-link" href="{{ path('app_companies') }}"><i class="fas fa-chart-bar me-1"></i> Cégstatisztikák</a>
        </div>
    </div>
</nav>

<div class="container">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success shadow-2" role="alert">
            <i class="fas fa-check-circle me-2"></i> {{ message }}
        </div>
    {% endfor %}

    {% block body %}{% endblock %}
</div>

<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/7.2.0/mdb.umd.min.js"></script>


<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof mdb !== 'undefined' && mdb.Input) {
            document.querySelectorAll('.form-outline').forEach((formOutline) => {
                new mdb.Input(formOutline).init();
            });
        }
    });
</script>

</body>
</html>