{% extends 'base.html.twig' %}

{% block title %}Cégstatisztikák{% endblock %}

{% block body %}
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2>Cégstatisztikák</h2>
        </div>
        <div class="col-md-4">
            <form method="get" action="{{ path('app_companies') }}" class="d-flex">
                <input type="text" name="q" value="{{ searchQuery }}" class="form-control me-2" placeholder="Szűrés cégre...">
                <button type="submit" class="btn btn-secondary btn-sm">Szűrés</button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
            <tr>
                <th>Cég neve</th>
                <th class="text-center">Vélemények száma</th>
                <th class="text-center">Átlagos értékelés</th>
            </tr>
            </thead>
            <tbody>
            {% for company in companies %}
                <tr>
                    <td><strong>{{ company.companyName }}</strong></td>
                    <td class="text-center">{{ company.reviewCount }}</td>
                    <td class="text-center">
                    <span class="badge bg-warning text-dark fs-6">
                        {{ company.averageRating|number_format(2, ',', ' ') }} ★
                    </span>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">Nincs adat a statisztikákhoz.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}